rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function adminDoc() { return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }
    function isAdmin() { return adminDoc() && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true; }
    function hasApplicationPermission() {
      return isAdmin() && (
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == "superadmin" ||
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.permissions.all == true ||
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.permissions.applications == true
      );
    }
    function isApplicationOwner(applicationId) {
      return signedIn() && firestore.exists(/databases/(default)/documents/applications/$(applicationId))
        && firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.authUid == request.auth.uid;
    }
    function validFileSize() { return request.resource.size <= 10 * 1024 * 1024; }
    function validContentType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }
    match /applications/{applicationId}/{fileName} {
      allow read: if isApplicationOwner(applicationId) || hasApplicationPermission();
      allow write: if (isApplicationOwner(applicationId) || hasApplicationPermission()) && validFileSize() && validContentType();
      allow delete: if isApplicationOwner(applicationId) || hasApplicationPermission();
    }
  }
}