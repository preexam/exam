rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminDoc() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function activeAdmin() { return adminDoc() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true; }
    function superAdmin() { return activeAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin'; }
    function permission(p) {
      return superAdmin() || (activeAdmin() && (
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions.all == true ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions[p] == true
      ));
    }
    function owner(appId) {
      return signedIn() && exists(/databases/$(database)/documents/applications/$(appId))
        && get(/databases/$(database)/documents/applications/$(appId)).data.authUid == request.auth.uid;
    }
    function activeExamId() {
      return exists(/databases/$(database)/documents/settings/portal)
        ? get(/databases/$(database)/documents/settings/portal).data.get('activeExamId', 'default')
        : 'default';
    }
    function ownerCreate(applicationId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'applicationNumber','authUid','candidateId','personal','status',
          'paymentStatus','examId','createdAt','updatedAt'
        ])
        && request.resource.data.applicationNumber == applicationId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.candidateId == request.auth.uid
        && request.resource.data.status == 'Application Incomplete'
        && request.resource.data.paymentStatus == 'Pending'
        && request.resource.data.examId == activeExamId();
    }
    function correctionOpen(app) {
      return signedIn()
        && app.examId != null
        && exists(/databases/$(database)/documents/exams/$(app.examId))
        && get(/databases/$(database)/documents/exams/$(app.examId)).data.allowCorrection == true
        && get(/databases/$(database)/documents/exams/$(app.examId)).data.correctionStartMs != null
        && get(/databases/$(database)/documents/exams/$(app.examId)).data.correctionEndMs != null
        && request.time.toMillis() >= get(/databases/$(database)/documents/exams/$(app.examId)).data.correctionStartMs
        && request.time.toMillis() <= get(/databases/$(database)/documents/exams/$(app.examId)).data.correctionEndMs;
    }

    function paymentSatisfied(app) {
      return app.paymentStatus == 'Successful'
        || (app.examId != null
          && exists(/databases/$(database)/documents/exams/$(app.examId))
          && get(/databases/$(database)/documents/exams/$(app.examId)).data.paymentRequired == false);
    }

    match /admins/{uid} {
      allow read: if superAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if superAdmin();
    }
    match /settings/{id} { allow read: if true; allow write: if permission('settings'); }
    match /exams/{id} { allow read: if true; allow write: if permission('exams'); }
    match /candidates/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update: if (signedIn() && request.auth.uid == uid) || permission('applications');
      allow delete: if permission('applications');
    }
    match /applications/{id} {
      allow create: if ownerCreate(id);
      allow read: if permission('applications') || owner(id);
      allow update: if permission('applications') || (
        owner(id)
        && resource.data.status != 'Final Submitted'
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.applicationNumber == resource.data.applicationNumber
        && request.resource.data.candidateId == resource.data.candidateId
        && (request.resource.data.status == resource.data.status || (resource.data.status == 'Application Incomplete' && request.resource.data.status == 'Final Submitted' && request.resource.data.declarationAccepted == true && paymentSatisfied(request.resource.data)) || (resource.data.status == 'Correction Required' && correctionOpen(resource.data) && request.resource.data.status == 'Final Submitted' && request.resource.data.declarationAccepted == true && paymentSatisfied(request.resource.data))) && (resource.data.status != 'Correction Required' || correctionOpen(resource.data))
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'personal','address','education','category','other','documents','documentVerification','status',
          'declarationAccepted','updatedAt','finalSubmittedAt'
        ])
      );
      allow delete: if permission('applications');
    }
    match /payments/{id} {
      allow read: if permission('payments') || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create, update, delete: if permission('payments');
    }
    match /admitCards/{id} {
      allow read: if permission('admit') || (signedIn() && resource.data.authUid == request.auth.uid && resource.data.published == true);
      allow write: if permission('admit');
    }
    match /results/{id} {
      allow read: if permission('results') || (signedIn() && resource.data.authUid == request.auth.uid && resource.data.published == true);
      allow write: if permission('results');
    }
    match /onlineAttempts/{attemptId} {
      allow create: if attemptId == request.resource.data.examId + '_' + request.resource.data.applicationNumber
        && signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == 'Starting'
        && request.resource.data.answers is map
        && request.resource.data.examId != null
        && request.resource.data.applicationNumber != null
        && exists(/databases/$(database)/documents/applications/$(request.resource.data.applicationNumber))
        && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationNumber)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationNumber)).data.examId == request.resource.data.examId
        && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationNumber)).data.status in ['Final Submitted','Approved']
        && exists(/databases/$(database)/documents/exams/$(request.resource.data.examId))
        && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.onlineExamEnabled == true
        && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.onlineExamPublished == true
        && (get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.onlineExamRequiresPayment != true
          || get(/databases/$(database)/documents/applications/$(request.resource.data.applicationNumber)).data.paymentStatus == 'Successful');
      allow get: if permission('results') || (signedIn() && resource.data.authUid == request.auth.uid);
      allow list: if permission('results');
      allow update: if permission('results') || (
        signedIn()
        && resource.data.authUid == request.auth.uid
        && resource.data.status == 'In Progress'
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.examId == resource.data.examId
        && request.resource.data.applicationNumber == resource.data.applicationNumber
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && (
          (request.resource.data.status == 'In Progress'
            && request.time <= resource.data.expiresAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','currentIndex','updatedAt']))
          ||
          (request.resource.data.status == 'Submitted'
            && request.resource.data.answers == resource.data.answers
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','submittedAt','autoSubmitted','updatedAt','currentIndex'])
            && request.resource.data.submittedAt != null
            && request.time <= resource.data.expiresAt + duration.value(5, 's'))
        )
      );
      allow delete: if permission('results');
      match /questions/{questionId} {
        allow get, list: if signedIn() && (
          permission('results') ||
          get(/databases/$(database)/documents/onlineAttempts/$(attemptId)).data.authUid == request.auth.uid
        );
        allow write: if false;
      }
    }

    match /onlineQuestions/{examId}/items/{questionId} {
      allow read, write: if permission('exams');
    }

    match /onlineAnswerKeys/{examId}/items/{questionId} {
      allow read, write: if permission('exams');
    }

    match /centres/{id} { allow read: if true; allow write: if permission('centres'); }
    match /customFields/{id} { allow read: if signedIn(); allow write: if permission('formBuilder'); }
    match /documents/{id} { allow read: if signedIn(); allow write: if permission('documents'); }
    match /notices/{id} { allow read: if true; allow write: if permission('notices'); }
    match /auditLogs/{id} {
      allow read: if permission('audit');
      allow create: if activeAdmin();
      allow update, delete: if superAdmin();
    }
    match /reports/{id} { allow read, write: if permission('reports'); }
  }
}