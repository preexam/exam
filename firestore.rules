rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isOwner(candidateId) {
      return signedIn() && request.auth.uid == candidateId;
    }

    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /candidates/{candidateId} {
      allow create: if isOwner(candidateId);
      allow read, update: if isOwner(candidateId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if signedIn();
      allow read, update: if isAdmin()
        || (signedIn() && resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create, update: if isAdmin();
    }

    match /admitCards/{applicationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.authUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /results/{applicationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.authUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /centres/{centreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /customFields/{fieldId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
